  "systemAudit": [
    {
      "system": "Poemworlds & Codex Readings",
      "classification": "original-recording",
      "bus": "voice",
      "dryReferenceAvailable": true,
      "note": "Primary spoken poem line preserved at original speaker pitch and cadence; delaySend locked to 0.0 by default."
    },
    {
      "system": "Codex Duets",
      "classification": "original-recording",
      "bus": "music",
      "dryReferenceAvailable": true,
      "note": "Call-and-response sung replies scheduled strictly after spoken line completion so voice intelligibility is never masked."
    },
    {
      "system": "Radio Atlantis",
      "classification": "rendered-mix",
      "bus": "music",
      "dryReferenceAvailable": false,
      "note": "Pre-rendered station broadcast flagged for dry re-render where station echo is baked into source file."
    },
    {
      "system": "Observatory & MovieMap Spatializer",
      "classification": "live-effect",
      "bus": "localAmbience",
      "dryReferenceAvailable": true,
      "note": "WebAudio BiquadFilter + stone impulse ConvolverNode driven by Severn threshold doorOpen and camera frustum proximity."
    }
  ],
  "buses": {
    "voice": {
      "id": "voice",
      "label": "Voice",
      "defaultGain": 0.90,
      "gainRange": [0.0, 1.0],
      "delaySend": 0.0,
      "echoFeedback": 0.0,
      "dryReference": true,
      "priority": 1,
      "role": "Primary spoken poem recording and resident dialogue; intelligible dry signal before any room reflection."
    },
    "closeAction": {
      "id": "closeAction",
      "label": "Close Action",
      "defaultGain": 0.72,
      "gainRange": [0.0, 1.0],
      "delaySend": 0.0,
      "maxSimultaneousEvents": 2,
      "priority": 2,
      "role": "Contact-bound footsteps on gravel/stone, cistern hand-pump strokes, parcel handoff, and jerrycan water pour."
    },
    "localAmbience": {
      "id": "localAmbience",
      "label": "Local Ambience",
      "defaultGain": 0.58,
      "gainRange": [0.0, 1.0],
      "delaySend": 0.0,
      "priority": 3,
      "role": "Bounded Severn vestibule/courtyard room tone, nocturnal insects, and canal water edge tied to tidePhase."
    },
    "distantCity": {
      "id": "distantCity",
      "label": "Distant City",
      "defaultGain": 0.36,
      "gainRange": [0.0, 0.75],
      "delaySend": 0.0,
      "duckedByVoiceDb": -8.5,
      "priority": 4,
      "role": "Budgeted Mount Vernon / harbor horizon bed attenuated by Severn door closure and ducked during speech."
    },
    "music": {
      "id": "music",
      "label": "Music",
      "defaultGain": 0.42,
      "gainRange": [0.0, 0.85],
      "delaySend": 0.0,
      "duckedByVoiceDb": -6.0,
      "callAndResponsePlacement": "after-spoken-line",
      "priority": 5,
      "role": "Restrained score cues and post-line sung duet replies; silence treated as an explicit timed state."
    }
  },
  "mixAndAcousticRules": {
    "voiceDelayDefault": 0.0,
    "speechDucking": {
      "triggerBus": "voice",
      "thresholdDb": -34.0,
      "targets": {
        "distantCity": { "attenuationDb": -8.5, "attackSec": 0.08, "releaseSec": 0.42 },
        "music": { "attenuationDb": -6.0, "attackSec": 0.10, "releaseSec": 0.50 },
        "localAmbience": { "attenuationDb": -3.0, "attackSec": 0.12, "releaseSec": 0.45 }
      }
    },
    "doorCoupledTransmission": {
      "stateProperty": "doorOpen",
      "sharedWithNavigation": true,
      "building": "severn",
      "openingId": "severn-street-threshold-01",
      "whenDoorOpen": {
        "walkable": true,
        "exteriorLowpassHz": 13500,
        "exteriorTransmissionGain": 0.62,
        "interiorReverbSend": 0.06,
        "reverbPreset": "open-vestibule-air",
        "transitionTimeConstantSec": 0.22
      },
      "whenDoorClosed": {
        "walkable": false,
        "exteriorLowpassHz": 640,
        "exteriorTransmissionGain": 0.22,
        "interiorReverbSend": 0.34,
        "reverbPreset": "severn-stone-lobby-1.55s",
        "rt60Sec": 1.55,
        "voicePreDelayMs": 0,
        "transitionTimeConstantSec": 0.22
      },
      "whenSubmerged": {
        "era": "submerged-ruin",
        "exteriorLowpassHz": 1800,
        "waterPlaybackRate": 0.72,
        "distantCityGainScale": 0.25
      }
    },
    "silenceStates": [
      { "id": "threshold-hold", "durationSec": 1.4, "trigger": "after-door-close-before-poem-line" },
      { "id": "post-handoff-stillness", "durationSec": 2.0, "trigger": "parcelHolder-becomes-bekele" }
    ]
  },
