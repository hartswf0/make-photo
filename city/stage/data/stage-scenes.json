  "duetLines": [
    {
      "speaker": "Poet Hero",
      "role": "poet_hero",
      "line": "The gates open with wings gifted from evolution, and made of marble stones."
    },
    {
      "speaker": "Imani",
      "role": "imani",
      "line": "Poets eased generations down yellow brick roads to follow comets to the capital city."
    },
    {
      "speaker": "Elder Bekele",
      "role": "bekele",
      "line": "An orchestra of our ancestors wildest dreams rises where the tide meets kintsugi stone."
    },
    {
      "speaker": "Makeda",
      "role": "makeda",
      "line": "Water drawn at the threshold cools the lamp and mirrors the parabolic sky."
    },
    {
      "speaker": "June",
      "role": "june",
      "line": "Shadows cast from narrow streets give us infinite time to heal and set clouds free."
    },
    {
      "speaker": "Cutout Twin",
      "role": "cutout_twin",
      "line": "Brass pivots hold thirty-one paper bones steady until the marble wings catch wind."
    },
    {
      "speaker": "Chorus Gatekeeper",
      "role": "chorus",
      "line": "A city born in unison out of the purest of fictions, welcoming me and welcoming all."
    }
  ]
}